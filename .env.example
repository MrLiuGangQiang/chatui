# Copy this file to `.env` or provide the values through your container/orchestrator.
# This project does not load `.env` automatically; use your deployment platform to inject variables.
# Do not put real API keys, database passwords, or DingTalk secrets in this file before committing.

# HTTP runtime
# Bind loopback by default. Set 0.0.0.0 only behind a trusted firewall or reverse proxy.
HOST=127.0.0.1
PORT=8765
NODE_ENV=production
UPSTREAM_TIMEOUT_MS=600000
MAX_CONNECTIONS=10000
CHATUI_PID_DIR=/tmp/chatui
CHATUI_DISABLE_PID_FILE=0
CHATUI_ALLOWED_ORIGINS=
# Unsafe for public deployments; prefer the explicit allowlist above.
CHATUI_ALLOW_ANY_ORIGIN=0
# Modern browsers are recognized as same-origin behind a TLS-terminating proxy
# via Fetch Metadata. List the external HTTPS Origin above only for clients that
# omit Fetch Metadata; forwarded protocol headers are intentionally not trusted.

# OpenAI-compatible upstream and request policy
DEFAULT_UPSTREAM_BASE_URL=https://ingress.lfans.cn/v1
CHATUI_CONTEXT_WINDOW_TOKENS=262144
CHATUI_ALLOW_PRIVATE_UPSTREAM=0
CHATUI_UPSTREAM_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
MAX_UPSTREAM_CONCURRENCY=30
MAX_UPSTREAM_QUEUE=100

# Bounded upstream responses and job-event subscribers
MAX_UPSTREAM_RESPONSE_BYTES=33554432
MAX_IMAGE_PROXY_BYTES=26214400
MAX_JOB_SUBSCRIBERS=32
MAX_TOTAL_JOB_SUBSCRIBERS=2048
MAX_JOB_SUBSCRIBER_BUFFER_BYTES=1048576

# SECURITY BOUNDARY
# ChatUI currently has no built-in API authentication or per-user Job ownership.
# Deploy only on a trusted local network or behind an authenticated reverse proxy/gateway.
# The deprecated CHATUI_DEPLOYMENT_MODE, CHATUI_AUTH_TOKENS, and
# MAX_MANAGED_JOBS_PER_PRINCIPAL variables are intentionally unsupported.
# Supplying managed-auth values causes startup to fail rather than creating false security.

# Managed job retention (in-memory in the current release)
JOB_TTL_MS=3600000
RUNNING_JOB_TTL_MS=660000
MAX_JOBS_PER_STORE=200
JOB_SWEEP_INTERVAL_MS=300000

# Attachment extraction limits
# Default for JSON readers without a route-specific limit.
MAX_BODY_BYTES=1048576
MAX_EXTRACT_CONCURRENCY=3
MAX_EXTRACT_QUEUE=20
EXTRACT_TIMEOUT_MS=120000
MAX_EXTRACT_TEXT_BYTES=5242880
MAX_EXTRACT_PDF_BYTES=26214400
MAX_EXTRACT_OFFICE_BYTES=26214400

# Optional PostgreSQL usage statistics
POSTGRES_URL=
PG_POOL_MIN=0
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# IANA time zone used for 今日/周/月 usage boundaries and XLSX timestamps.
USAGE_TIME_ZONE=Asia/Shanghai
# PGSSL: disable/false (off), require/true (encrypted without certificate
# verification), or verify-ca/verify-full (certificate verification enabled).
PGSSL=
USAGE_RANKING_LIMIT=10
USAGE_DEPARTMENT_PASSWORD=
MAX_USAGE_REFRESH_BUCKETS=4096

# Optional DingTalk feedback integration
DINGTALK_FEEDBACK_ACCESS_TOKEN=
DINGTALK_FEEDBACK_SECRET=

# Diagnostics: redacts credentials and large image payloads before logging
CHATUI_VERBOSE_LOGS=0
